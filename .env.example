# Wine & Spirits POS — Environment Variables
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# Django secret key (generate a unique one for production)
SECRET_KEY=

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL (leave empty to use SQLite)
# Example for PostgreSQL: postgres://user:password@localhost:5432/wine_spirits_pos
DATABASE_URL=
